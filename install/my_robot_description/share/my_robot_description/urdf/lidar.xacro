<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:property name="lidar_radius" value="0.01" />
    <xacro:property name="lidar_width" value="0.01" />

    <link name="laser">
            <visual>
                <geometry>
                    <cylinder radius="${lidar_radius}" length="${lidar_width}" />
                </geometry>
            </visual>
            <collision>
                <geometry>
                    <cylinder radius="${lidar_radius}" length="${lidar_width}" />
                </geometry>
            </collision>
            <inertial>
                <mass value="0.1"/>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
            </inertial>
    </link>

    <joint name="base_lidar_joint" type="fixed">
            <parent link="base_link" />
            <child link="laser" />
            <origin xyz="0.65 -0.50 0.75" rpy="0 0 0" />
    </joint>
</robot>