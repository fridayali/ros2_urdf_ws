<?xml version="1.0" ?>
<robot name="simple_rover" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:property name="base_length" value="1.88"/>
  <xacro:property name="base_height" value="0.7"/>
  <xacro:property name="base_width" value="1.52"/>
  <xacro:property name="wheel_radius" value="0.272"/>
  <xacro:property name="wheel_width" value="0.162"/>
<!-- 
  <link name="base_footprint"/> -->
  <link name="base_link">
    <visual>
      <geometry>
         <mesh filename="package://my_robot_description/meshes/base_robot_amiga.dae" scale="1 1 1"/>
      </geometry>
      <origin rpy="0 0 ${pi}" xyz="0 0 0"/>
      <material name="gray"/>
    </visual>
    <xacro:box_inertia m="100" x="${base_length}" y="${base_width}" z="${base_height}" o_xyz="0 0 ${base_height/2}" o_rpy="0 0 0"/>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0.55"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
    </collision>
  </link>
  <!-- <joint name="base_link_footprint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin rpy="0 0 0" xyz="0 0 ${wheel_radius}"/>
    <axis xyz="0 0 0"/>
  </joint> -->
  <link name="front_left_wheel">
    <visual>
      <geometry>
        <mesh filename="package://my_robot_description/meshes/wheel.dae" scale="1 1 1"/>
      </geometry>
      <origin rpy="0 0 ${pi}" xyz="0 0 0"/>
      <material name="black"/>
    </visual>
    <xacro:cylinder_inertia m="10" r="${wheel_radius}" h="${wheel_width}" o_xyz="0 0 0" o_rpy="${pi/2} 0 0"/>
    <collision>
      <geometry>
        <cylinder length="${wheel_width}" radius="${wheel_radius}"/>
      </geometry>
      <origin rpy="${pi / 2} 0 0" xyz="0 0 0"/>
    </collision>
  </link>
  <joint name="front_left_joint" type="continuous">
    <parent link="base_link"/>
    <child link="front_left_wheel"/>
    <origin rpy="0 0 0" xyz="0.60468 -0.57165 0.27"/>
    <axis xyz="0 1 0"/>
  </joint>
  <link name="front_right_wheel">
    <visual>
      <geometry>
        <mesh filename="package://my_robot_description/meshes/wheel.dae" scale="1 1 1"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <material name="black"/>
    </visual>
    <xacro:cylinder_inertia m="10" r="${wheel_radius}" h="${wheel_width}" o_xyz="0 0 0" o_rpy="${pi/2} 0 0"/>
    <collision>
      <geometry>
        <cylinder length="${wheel_width}" radius="${wheel_radius}"/>
      </geometry>
      <origin rpy="${pi / 2} 0 0" xyz="0 0 0"/>
    </collision>
  </link>
  <joint name="front_right_joint" type="continuous">
    <parent link="base_link"/>
    <child link="front_right_wheel"/>
    <origin rpy="0 0 0" xyz="0.60468 0.5403 0.27"/>
    <axis xyz="0 1 0"/>
  </joint>
  <link name="rear_left_wheel">
    <visual>
      <geometry>
        <mesh filename="package://my_robot_description/meshes/wheel.dae" scale="1 1 1"/>
      </geometry>
      <origin rpy="0 0 ${pi}" xyz="0 0 0"/>
      <material name="black"/>
    </visual>
    <xacro:cylinder_inertia m="10" r="${wheel_radius}" h="${wheel_width}" o_xyz="0 0 0" o_rpy="${pi/2} 0 0"/>
    <collision>
      <geometry>
        <cylinder length="${wheel_width}" radius="${wheel_radius}"/>
      </geometry>
      <origin rpy="${pi / 2} 0 0" xyz="0 0 0"/>
    </collision>
  </link>
  <joint name="rear_left_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_left_wheel"/>
    <origin rpy="0 0 0" xyz="-0.89016 -0.57165 0.27"/>
    <axis xyz="0 1 0"/>
  </joint>
  <link name="rear_right_wheel">
    <visual>
      <geometry>
        <mesh filename="package://my_robot_description/meshes/wheel.dae" scale="1 1 1"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <material name="black"/>
    </visual>
    <xacro:cylinder_inertia m="10" r="${wheel_radius}" h="${wheel_width}" o_xyz="0 0 0" o_rpy="${pi/2} 0 0"/>
    <collision>
      <geometry>
        <cylinder length="${wheel_width}" radius="${wheel_radius}"/>
      </geometry>
      <origin rpy="${pi / 2} 0 0" xyz="0 0 0"/>
    </collision>
  </link>
  <joint name="rear_right_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_right_wheel"/>
    <origin rpy="0 0 0" xyz="-0.89016 0.5403 0.27"/>
    <axis xyz="0 1 0"/>
  </joint>
</robot>
