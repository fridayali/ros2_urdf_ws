<?xml version="1.0" ?>
<robot name="simple_rover" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <gazebo reference="rear_right_joint">
    <mu1 value="0.8" />
    <mu2 value="0.8" />
  </gazebo>

  <gazebo reference="rear_left_joint">
    <mu1 value="0.8" />
    <mu2 value="0.8" />
  </gazebo>
  
  <gazebo>
    <plugin
      filename="gz-sim-diff-drive-system" 
      name="gz::sim::systems::DiffDrive">
      
      <left_joint>front_right_joint</left_joint>
      <right_joint>front_left_joint</right_joint>
        
      <left_joint>rear_right_joint</left_joint>
      <right_joint>rear_left_joint</right_joint> 
      <wheel_separation>1.11195</wheel_separation> 
      <wheel_radius>0.272</wheel_radius>
      <odom_topic>odom</odom_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <odom_publisher_frequency>30</odom_publisher_frequency>
      <tf_topic>/tf</tf_topic>
    </plugin>
  </gazebo>
  <gazebo>
    <plugin
      filename="gz-sim-joint-state-publisher-system"
      name="gz::sim::systems::JointStatePublisher">
      <joint name="front_left_joint"></joint>
      <joint name="front_right_joint"></joint>
    </plugin>
  </gazebo>
</robot>