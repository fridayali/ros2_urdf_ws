<?xml version="1.0"?>
<robot name="my_robot">

    <material name="blue">
        <color rgba="0 0 0.5 1" />
    </material>

    <material name="grey">
        <color rgba="0.5 0.5 0.5 1" />
    </material>

    <material name="black">
        <color rgba="0.0 0.0 0.0 1" />
    </material>

    <link name="base_link">
        <visual>
            <geometry>
                <box size="0.63 0.34 0.26" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <material name="blue" />
        </visual>
    </link>

    <link name="laser">
        <visual>
            <geometry>
                <cylinder radius="0.03" length="0.04"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <material name="grey"/>
        </visual>
    </link>
    
    <link name="point_lidar_front">
        <visual>
            <geometry>
                <box size="0.0185 0.035 0.021"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <material name="black"/>
        </visual>
    </link>
    
    <link name="point_lidar_rear">
        <visual>
            <geometry>
                <box size="0.0185 0.035 0.021"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <material name="black"/>
        </visual>
    </link>
    
    <link name="imu_link" />

    <link name="front_right_wheel_link">
        <visual>
            <geometry>
                <cylinder radius="0.115" length="0.07" />
            </geometry>
            <origin xyz="0 0 0" rpy="1.57 0 0" />
            <material name="grey" />
        </visual>
    </link>
    <link name="front_left_wheel_link">
        <visual>
            <geometry>
                <cylinder radius="0.115" length="0.07" />
            </geometry>
            <origin xyz="0 0 0" rpy="1.57 0 0" />
            <material name="grey" />
        </visual>
    </link>
     <link name="rear_right_wheel_link">
        <visual>
            <geometry>
                <cylinder radius="0.115" length="0.07" />
            </geometry>
            <origin xyz="0 0 0" rpy="1.57 0 0" />
            <material name="grey" />
        </visual>
    </link>
    <link name="rear_left_wheel_link">
        <visual>
            <geometry>
                <cylinder radius="0.115" length="0.07" />
            </geometry>
            <origin xyz="0 0 0" rpy="1.57 0 0" />
            <material name="grey" />
        </visual>
    </link>

    <joint name="lidar_joint" type="fixed">
        <parent link="base_link"/>
        <child link="laser"/>
        <origin xyz="0.30 0.0 0.15" rpy="0 0 0"/>
    </joint>

    <joint name="imu_joint" type="fixed">
        <parent link="base_link"/>
        <child link="imu_link"/>
        <origin xyz="0 0 0.14" rpy="0 0 0"/>
    </joint>

    <joint name="point_lidar_front_joint" type="fixed">
        <parent link="base_link"/>
        <child link="point_lidar_front"/>
        <origin xyz="0.32 0.0 -0.04" rpy="0 0 0"/>
    </joint>

    <joint name="point_lidar_rear_joint" type="fixed">
        <parent link="base_link"/>
        <child link="point_lidar_rear"/>
        <origin xyz="-0.32 0.0 -0.07" rpy="0 0 3.141592653589793"/>
    </joint>

    <joint name="front_right_wheel_joint" type="continuous">
        <parent link="base_link" />
        <child link="front_right_wheel_link" />
        <origin xyz="0.175 0.205 -0.13" rpy="0 0 0" />
        <axis xyz="0 1 0" />
    </joint>

    <joint name="front_left_wheel_joint" type="continuous">
        <parent link="base_link" />
        <child link="front_left_wheel_link" />
         <origin xyz="-0.175 0.205 -0.13" rpy="0 0 0" />
        <axis xyz="0 1 0" />
    </joint>
    <joint name="rear_right_wheel_joint" type="continuous">
        <parent link="base_link" />
        <child link="rear_right_wheel_link" />
         <origin xyz="0.175 -0.205 -0.13" rpy="0 0 0" />
        <axis xyz="0 1 0" />
    </joint>

    <joint name="rear_left_wheel_joint" type="continuous">
        <parent link="base_link" />
        <child link="rear_left_wheel_link" />
         <origin xyz="-0.175 -0.205 -0.13" rpy="0 0 0" />
        <axis xyz="0 1 0" />
    </joint>



</robot>

