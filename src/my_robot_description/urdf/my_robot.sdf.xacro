<?xml version="1.0" ?>
<sdf version="1.8" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <model name="simple_rover">

    <xacro:property name="base_length" value="1.88"/>
    <xacro:property name="base_height" value="0.7"/>
    <xacro:property name="base_width" value="1.52"/>
    <xacro:property name="wheel_radius" value="0.272"/>
    <xacro:property name="wheel_width" value="0.162"/>
    <xacro:property name="gps_radius" value="0.01" />
    <xacro:property name="gps_width" value="0.01" />

    <xacro:macro name="box_inertia" params="m x y z o_xyz o_rpy">
        <inertial>
          <origin xyz="${o_xyz}" rpy="${o_rpy}"/>
          <mass value="${m}"/>
          <inertia ixx="${(m/12) * (y*y + z*z)}" ixy="0.0" ixz="0.0"
                   iyy="${(m/12) * (x*x + z*z)}" iyz="0.0"
                   izz="${(m/12) * (x*x + y*y)}"/>
        </inertial>
    </xacro:macro>

    <xacro:macro name="cylinder_inertia" params="m r h o_xyz o_rpy">
        <inertial>
          <origin xyz="${o_xyz}" rpy="${o_rpy}"/>
          <mass value="${m}"/>
          <inertia ixx="${(m/12) * (3*r*r + h*h)}" ixy="0.0" ixz="0.0"
                   iyy="${(m/12) * (3*r*r + h*h)}" iyz="0.0"
                   izz="${(m/2) * (r*r)}"/>
        </inertial>
    </xacro:macro>
    
    <link name="base_link">
      <visual name="base_link_visual">
        <geometry>
           <mesh><uri>package://my_robot_description/meshes/base_robot_amiga.dae</uri><scale>1 1 1</scale></mesh>
        </geometry>
        <origin rpy="0 0 ${pi}" xyz="0 0 0"/>
        <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
      </visual>
      <xacro:box_inertia m="100" x="${base_length}" y="${base_width}" z="${base_height}" o_xyz="0 0 0.55" o_rpy="0 0 0"/>
      <collision name="base_link_collision">
        <origin rpy="0 0 0" xyz="0 0 0.55"/>
        <geometry>
          <box><size>${base_length} ${base_width} ${base_height}</size></box>
        </geometry>
      </collision>
    </link>

    <xacro:macro name="wheel_macro" params="prefix parent_link x_coord y_coord">
      <link name="${prefix}_wheel">
        <visual name="${prefix}_visual">
          <geometry><mesh><uri>package://my_robot_description/meshes/wheel.dae</uri><scale>1 1 1</scale></mesh></geometry>
          <origin rpy="0 0 ${pi}" xyz="0 0 0"/>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
        </visual>
        <xacro:cylinder_inertia m="10" r="${wheel_radius}" h="${wheel_width}" o_xyz="0 0 0" o_rpy="${pi/2} 0 0"/>
        <collision name="${prefix}_collision">
          <geometry><cylinder length="${wheel_width}" radius="${wheel_radius}"/></geometry>
          <origin rpy="${pi / 2} 0 0" xyz="0 0 0"/>
        </collision>
      </link>
      <joint name="${prefix}_joint" type="revolute">
        <parent>${parent_link}</parent>
        <child>${prefix}_wheel</child>
        <axis><xyz>0 1 0</xyz></axis>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
        </limit>
        <physics>
            <ode><limit><cfm>0.0</cfm><erp>0.9</erp></limit></ode>
        </physics>
        <pose relative_to="${parent_link}">${x_coord} ${y_coord} 0.27 0 0 0</pose>
      </joint>
      
      <link name="${prefix}_wheel">
        <surface>
          <friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction>
        </surface>
      </link>
    </xacro:macro>

    <xacro:wheel_macro prefix="front_left" parent_link="base_link" x_coord="0.60468" y_coord="-0.57165" />
    <xacro:wheel_macro prefix="front_right" parent_link="base_link" x_coord="0.60468" y_coord="0.5403" />
    <xacro:wheel_macro prefix="rear_left" parent_link="base_link" x_coord="-0.89016" y_coord="-0.57165" />
    <xacro:wheel_macro prefix="rear_right" parent_link="base_link" x_coord="-0.89016" y_coord="0.5403" />


    <link name="imu_link">
        <visual name="imu_visual"><geometry><box><size>0.01 0.01 0.01</size></box></geometry></visual>
        <collision name="imu_collision"><geometry><box><size>0.01 0.01 0.01</size></box></geometry></collision>
        <inertial>
            <mass>0.1</mass><inertia><ixx>1.67e-06</ixx><ixy>0.0</ixy><ixz>0.0</ixz><iyy>1.67e-06</iyy><iyz>0.0</iyz><izz>1.67e-06</izz></inertia>
        </inertial>
        <sensor name="imu_sensor" type="imu">
            <always_on>true</always_on><update_rate>100</update_rate><visualize>true</visualize>
            <topic>demo/imu</topic>
            <imu>
                <angular_velocity>
                    <x><noise type="gaussian"><mean>0.0</mean><stddev>2e-4</stddev><bias_mean>0.0000075</bias_mean><bias_stddev>0.0000008</bias_stddev></noise></x>
                    <y><noise type="gaussian"><mean>0.0</mean><stddev>2e-4</stddev><bias_mean>0.0000075</bias_mean><bias_stddev>0.0000008</bias_stddev></noise></y>
                    <z><noise type="gaussian"><mean>0.0</mean><stddev>2e-4</stddev><bias_mean>0.0000075</bias_mean><bias_stddev>0.0000008</bias_stddev></noise></z>
                </angular_velocity>
                <linear_acceleration>
                    <x><noise type="gaussian"><mean>0.0</mean><stddev>1.7e-2</stddev><bias_mean>0.1</bias_mean><bias_stddev>0.001</bias_stddev></noise></x>
                    <y><noise type="gaussian"><mean>0.0</mean><stddev>1.7e-2</stddev><bias_mean>0.1</bias_mean><bias_stddev>0.001</bias_stddev></noise></y>
                    <z><noise type="gaussian"><mean>0.0</mean><stddev>1.7e-2</stddev><bias_mean>0.1</bias_mean><bias_stddev>0.001</bias_stddev></noise></z>
                </linear_acceleration>
            </imu>
        </sensor>
    </link>
    <joint name="imu_joint" type="fixed"><parent>base_link</parent><child>imu_link</child><pose>0.54 0.44 2.30 0 0 0</pose></joint>


    <link name="gps_link">
        <visual name="gps_visual"><geometry><cylinder radius="${gps_radius}" length="${gps_width}" /></geometry></visual>
        <collision name="gps_collision"><geometry><cylinder radius="${gps_radius}" length="${gps_width}" /></geometry></collision>
        <xacro:cylinder_inertia m="0.1" r="${gps_radius}" h="${gps_width}" o_xyz="0 0 0" o_rpy="0 0 0" />
        <sensor name="navsat" type="navsat">
            <always_on>true</always_on><update_rate>5.0</update_rate><topic>/gps/fix</topic> 
            <navsat>
                <position_sensing>
                        <horizontal><noise type="gaussian"><mean>0.0</mean><stddev>0.01</stddev></noise></horizontal> <vertical><noise type="gaussian"><mean>0.0</mean><stddev>0.02</stddev></noise></vertical>   </position_sensing>
            </navsat>
        </sensor>
    </link>
    <joint name="base_gps_joint" type="fixed"><parent>base_link</parent><child>gps_link</child><pose>0.54 0.44 2.38 0 0 0</pose></joint>


    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
        <left_joint>front_left_joint</left_joint>
        <right_joint>front_right_joint</right_joint>
        <left_joint>rear_left_joint</left_joint>
        <right_joint>rear_right_joint</right_joint> 
        <wheel_separation>1.11195</wheel_separation> 
        <wheel_radius>${wheel_radius}</wheel_radius>
        <odom_topic>odom</odom_topic>
        <frame_id>odom</frame_id>
        <child_frame_id>base_link</child_frame_id>
        <odom_publisher_frequency>30</odom_publisher_frequency>
        <tf_topic>/tf</tf_topic>
    </plugin>
    
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
        <joint name="front_left_joint"></joint>
        <joint name="front_right_joint"></joint>
        <joint name="rear_left_joint"></joint>
        <joint name="rear_right_joint"></joint>
    </plugin>

  </model>
</sdf>